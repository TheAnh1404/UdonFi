# ==============================================================================
# UdonFi V2 Environment Configuration Template
# Copy this file to .env and configure local values before running services.
# ==============================================================================

# --- Stellar Network Configurations ---
# Target Network (testnet | public | standalone)
STELLAR_NETWORK=testnet
# Soroban RPC Server Endpoint URL
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Stellar Horizon Server URL
HORIZON_URL=https://horizon-testnet.stellar.org
# Network Passphrase for transaction signing
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# --- Contract Addresses (Testnet Defaults) ---
POOL_CONTRACT_ID=CBP6X4XEFDSPJV7DCEQ7M4OEA2PZMXMHWMC3SE26FHOVC2AQQLZMWJY6
USDC_SAC_ID=CAO2VFOWACEHKUJXGFDX5MOYFDGL2OANBOB3AK33CUR6R3A2Y5IC65XQ
XLM_SAC_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
LIQUIDATION_CONTRACT_ID=CBB2A4...
RESERVE_CONFIG_CONTRACT_ID=CC...
ORACLE_AGGREGATOR_CONTRACT_ID=CD...

# --- Deployer/Operator Account Secrets ---
# Deployer Secret Seed (S...) - NEVER commit real keys!
DEPLOYER_SECRET_KEY=SA...
# Governance Guardian Multi-sig threshold addresses (Comma-separated)
GOVERNANCE_GUARDIANS=GD1...,GD2...,GD3...

# --- Backend Database (PostgreSQL) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=udonfi_operator
DB_PASSWORD=secure_development_password
DB_NAME=udonfi_v2_db
DB_SSL_ENABLED=false

# --- Redis Cache Layer ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Event Indexer Settings ---
# Block/Ledger number to start scanning events from
INDEXER_START_LEDGER=12000000
# Event scanning batch size (number of blocks per query)
INDEXER_BATCH_SIZE=100
# Reconnect delay in milliseconds on RPC timeout
INDEXER_RETRY_INTERVAL_MS=3000
# Socket.io communication port
INDEXER_PORT=3001

# --- Oracle API Credentials ---
# API key for Pyth Network Benchmark Feeds
PYTH_API_KEY=
# API key for Band Protocol Data Provider
BAND_PROTOCOL_API_KEY=

# --- Frontend Client ---
# Node environment (development | production)
NODE_ENV=development
# API Endpoint for the backend service
VITE_API_BASE_URL=http://localhost:3000
# Indexer push URL
VITE_INDEXER_SOCKET_URL=http://localhost:3001
